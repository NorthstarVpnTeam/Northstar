{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Northstar V2Ray",
  "version": "2.0.0",
  "identifier": "com.northstar.v2ray",
  "build": {
    "frontendDist": "../src/renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Northstar V2Ray",
        "width": 1280,
        "height": 820,
        "minWidth": 360,
        "minHeight": 560,
        "decorations": false,
        "resizable": true,
        "backgroundColor": "#eef1f6"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["../build/icon.ico", "../build/icon.png"],
    "resources": {
      "../core/xray.exe": "core/xray.exe",
      "../core/geoip.dat": "core/geoip.dat",
      "../core/geosite.dat": "core/geosite.dat",
      "../core/wintun.dll": "core/wintun.dll",
      "../core/LICENSE": "core/LICENSE",
      "../core/LICENSE-Wintun": "core/LICENSE-Wintun",
      "../scripts/system-proxy.ps1": "scripts/system-proxy.ps1"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"]
      }
    }
  }
}
