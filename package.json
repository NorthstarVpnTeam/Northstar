{
  "name": "northstar-v2ray",
  "productName": "Northstar V2Ray",
  "version": "2.0.0",
  "private": true,
  "description": "A lightweight Rust/Tauri V2Ray-compatible proxy configuration manager and client for Windows.",
  "license": "MIT",
  "author": {
    "name": "shupolol",
    "email": "northstar@example.com"
  },
  "homepage": "https://github.com/shupolol/Northstar",
  "repository": {
    "type": "git",
    "url": "https://github.com/shupolol/Northstar.git"
  },
  "scripts": {
    "start": "tauri dev",
    "dev": "tauri dev",
    "build": "npm run fetch:core && tauri build",
    "tauri": "tauri",
    "check": "node scripts/check-syntax.js",
    "test": "node --test \"tests/*.test.js\"",
    "test:rust": "cargo test -p northstar-core",
    "verify": "npm run check && npm test && npm run test:rust",
    "fetch:core": "node scripts/fetch-core.js",
    "verify:connect": "node scripts/verify-connection.js",
    "pack:win": "tauri build --no-bundle",
    "dist:win": "node scripts/fetch-core.js --platform win32 && tauri build"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.1"
  }
}
